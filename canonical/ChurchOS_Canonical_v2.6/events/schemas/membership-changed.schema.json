{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/church-os/membership-changed-1.0.schema.json",
  "title": "Church Membership Changed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "membership_id",
    "status",
    "revision"
  ],
  "properties": {
    "membership_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "PENDING",
        "ACTIVE",
        "INACTIVE"
      ]
    },
    "joined_on": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  }
}
